# Usuário administrador do API Manager com permissão de editar APPs e Access Tokens
# e com a permissão SECRETS (sem ela clientId/secret/código do token voltam mascarados).
# Todas as operações ficam registradas no audit do API Manager com este usuário.
sensedia-auth=<seu-token-de-autenticacao>
userId=<seu-user-id>
MANAGER_ORIGIN=<url-base-do-seu-manager-ex-https://manager.example.com>

# Opcional — só necessário se o path da API divergir do padrão /api-manager/api/v3
# MANAGER_BASE_URL=
